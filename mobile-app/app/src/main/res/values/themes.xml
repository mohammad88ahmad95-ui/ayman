<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AlAyman" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/neon</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
